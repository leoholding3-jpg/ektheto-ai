# Local/development values. Never commit populated credentials.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Supabase PostgreSQL and authentication
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# Sightengine image analysis
SIGHTENGINE_USER=YOUR_SIGHTENGINE_USER
SIGHTENGINE_SECRET=YOUR_SIGHTENGINE_SECRET

# NASA APOD and NeoWs. Replace DEMO_KEY with your free key before production.
NASA_API_KEY=DEMO_KEY

# News providers. GDELT does not require a key.
NEWSDATA_API_KEY=
GNEWS_API_KEY=
NEWSAPI_API_KEY=
