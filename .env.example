# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional external search & fact-checking APIs (STRICTLY server-side only, never expose in client):
# GOOGLE_FACT_CHECK_API_KEY=""
# GOOGLE_CUSTOM_SEARCH_API_KEY=""
# GOOGLE_CUSTOM_SEARCH_CX=""
# GNEWS_API_KEY=""
# TAVILY_API_KEY=""
# SERPER_API_KEY=""
# MEDIA_CDN_BASE_URL="" # Optional CDN transform prefix (e.g. Cloudflare /cdn-cgi/image or Cloudinary fetch)

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Sightengine credentials for the Ektheto Streamlit prototype.
SIGHTENGINE_USER=""
SIGHTENGINE_SECRET=""
