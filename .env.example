# Local/development values. Never commit populated credentials.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Sightengine image analysis
SIGHTENGINE_USER=YOUR_SIGHTENGINE_USER
SIGHTENGINE_SECRET=YOUR_SIGHTENGINE_SECRET

# Optional Gemini visual investigation. The image is sent to Google only when selected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# News providers. GDELT and Wikimedia Commons do not require a key.
NEWSDATA_API_KEY=
GNEWS_API_KEY=
NEWSAPI_API_KEY=
